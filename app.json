{
  "expo": {
    "name": "Club Manager",
    "slug": "campo-cani-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "campocaniapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "it.campocani.app",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Serve per stampare gli scontrini sul registratore telematico del campo."
      }
    },
    "android": {
      "package": "it.campocani.app",
      "adaptiveIcon": {
        "backgroundColor": "#123a2b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#123a2b",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Serve per scegliere dalla galleria il logo del campo e le foto di trainer e clienti.",
          "cameraPermission": "Serve per scattare le foto di trainer e clienti."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
