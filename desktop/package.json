{
  "name": "campo-cani-desktop",
  "productName": "Club Manager",
  "version": "1.0.0",
  "description": "Club Manager per Windows e Mac",
  "author": "domenichiniedo",
  "private": true,
  "main": "main.js",
  "scripts": {
    "web": "cd .. && cross-env CAMPO_CANI_DESKTOP=1 EXPO_PUBLIC_SOLO_PROPRIETARIO=1 npx expo export --platform web --output-dir desktop/web",
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --universal --publish never"
  },
  "devDependencies": {
    "cross-env": "7.0.3",
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "it.campocani.app",
    "productName": "Club Manager",
    "directories": { "output": "release" },
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "web", "to": "web" }],
    "protocols": [{ "name": "Club Manager", "schemes": ["campocaniapp"] }],
    "win": { "icon": "../assets/images/icon.png", "artifactName": "ClubManager-Setup-${version}.exe" },
    "mac": {
      "icon": "../assets/images/icon.png",
      "category": "public.app-category.business",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "ClubManager-${version}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "shortcutName": "Club Manager" }
  }
}
