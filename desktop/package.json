{
  "name": "campo-cani-desktop",
  "productName": "Campo Cani",
  "version": "1.0.0",
  "description": "Campo Cani per Windows",
  "author": "domenichiniedo",
  "private": true,
  "main": "main.js",
  "scripts": {
    "web": "cd .. && cross-env CAMPO_CANI_DESKTOP=1 npx expo export --platform web --output-dir desktop/web",
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "cross-env": "7.0.3",
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "it.campocani.app",
    "productName": "Campo Cani",
    "directories": { "output": "release" },
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "web", "to": "web" }],
    "protocols": [{ "name": "Campo Cani", "schemes": ["campocaniapp"] }],
    "win": { "icon": "../assets/images/icon.png", "artifactName": "CampoCani-Setup-${version}.exe" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "shortcutName": "Campo Cani" }
  }
}
